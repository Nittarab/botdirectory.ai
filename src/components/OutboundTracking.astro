<!-- Explicit outbound tracking. PostHog autocapture has not produced click
     events for this project, so record external destinations ourselves. -->
<script is:inline>
  (() => {
    const track = (event) => {
      if (event.type === 'auxclick' && event.button !== 1) return;

      const node = event.target;
      const element = node instanceof Element ? node : node instanceof Node ? node.parentElement : null;
      const link = element?.closest('a[href]');
      if (!(link instanceof HTMLAnchorElement)) return;

      let destination;
      try {
        destination = new URL(link.href, window.location.href);
      } catch {
        return;
      }

      const isWeb = destination.protocol === 'http:' || destination.protocol === 'https:';
      const isExternalWeb = isWeb && destination.origin !== window.location.origin;
      const isExternalProtocol = destination.protocol === 'mailto:' || destination.protocol === 'tel:';
      if (!isExternalWeb && !isExternalProtocol) return;

      const ph = window.posthog;
      if (!ph || typeof ph.capture !== 'function') return;

      const sponsor = link.dataset.sponsor;
      const taggedSponsor = destination.searchParams.get('utm_medium') === 'sponsor';
      const sponsorPlacement =
        link.dataset.sponsorPlacement || (taggedSponsor ? destination.searchParams.get('utm_campaign') : null);
      const linkText = (link.getAttribute('aria-label') || link.textContent || '')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 160);

      const properties = {
        destination_url: isWeb
          ? `${destination.origin}${destination.pathname}`
          : `${destination.protocol}${destination.pathname}`,
        destination_domain: isWeb ? destination.hostname : destination.protocol.slice(0, -1),
        destination_path: isWeb ? destination.pathname : null,
        source_path: window.location.pathname,
        link_text: linkText || null,
        link_id: link.id || null,
        link_target: link.target || '_self',
        opens_new_tab:
          link.target === '_blank' || event.metaKey || event.ctrlKey || event.shiftKey || event.button === 1,
        outbound_type: sponsor || taggedSponsor ? 'sponsor' : 'general',
      };

      if (sponsor) properties.sponsor = sponsor;
      if (sponsorPlacement) properties.sponsor_placement = sponsorPlacement;
      if (link.dataset.abVariant) properties.sponsor_copy_variant = link.dataset.abVariant;

      ph.capture('outbound_link_clicked', properties, {
        transport: 'sendBeacon',
        send_instantly: true,
      });
    };

    document.addEventListener('click', track, true);
    document.addEventListener('auxclick', track, true);
  })();
</script>
