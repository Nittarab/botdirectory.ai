---
/**
 * The brand icon in front of an integration name, when we have one in
 * public/icons/ (see data/tool-icons.json + `pnpm icons`). Renders nothing
 * otherwise — the chip is just the name. Mono logos ship a dark variant;
 * CSS swaps them on [data-theme='dark'].
 */
import { toolIcon } from '../lib/data';

interface Props {
  name: string;
  /** Icon box in px. */
  size: number;
}

const { name, size } = Astro.props;
const icon = toolIcon(name);
---

{
  icon && (
    <>
      <img src={icon.light} alt="" width={size} height={size} class:list={['tool-icon', icon.dark && 'tool-icon-light']} loading="lazy" decoding="async" />
      {icon.dark && <img src={icon.dark} alt="" width={size} height={size} class="tool-icon tool-icon-dark" loading="lazy" decoding="async" />}
    </>
  )
}
