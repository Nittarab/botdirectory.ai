{
  "name": "botdirectory",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "botdirectory.ai", "custom_domain": true },
    { "pattern": "www.botdirectory.ai", "custom_domain": true }
  ],
  // Pure static site: Wrangler serves the built Astro output as static assets.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
